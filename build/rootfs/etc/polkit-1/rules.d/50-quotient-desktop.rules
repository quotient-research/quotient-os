// The owner (sudo group), signed in at this computer, may start the one-time
// desktop install without a second password prompt: the kiosk just checked it.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "quotient-desktop-install.service" &&
      action.lookup("verb") == "start" &&
      subject.local && subject.active && subject.isInGroup("sudo")) {
    return polkit.Result.YES;
  }
});
