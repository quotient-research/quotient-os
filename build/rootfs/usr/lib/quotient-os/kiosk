#!/usr/bin/python3
"""The Mainframe's screen: the Quotient web app, full screen, in a locked-down view.

Runs as greetd's greeter (user quotient-kiosk) inside cage, from kiosk-session.
A title bar carries the Mainframe's name and a Desktop button (or Ctrl+Alt+D).
Desktop asks for the owner's password and starts a desktop session through
greetd; logging out of that session brings this screen back.

  kiosk                   the screen (greeter mode, needs GREETD_SOCK)
  kiosk --install-desktop the first-use desktop install, run in the owner's
                          session by desktop-session; exits 0 when installed

Only http://localhost is reachable; there is no context menu, no developer
tools, no new windows. Web storage persists (in the kiosk account's home): a
Quotient ID made here with "I'm new to Quotient" lives in it, and losing it
would lock the owner out.
"""
import grp
import json
import pwd
import time
import os
import socket
import struct
import subprocess
import sys
import threading
from urllib.parse import urlparse, urlunparse

import gi

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
from gi.repository import Gdk, Gio, GLib, Gtk, WebKit  # noqa: E402

HOME_URL = "http://localhost/"
SCREEN_STATE = "/run/quotient-os/screen.json"
INSTALL_STATE = "/run/quotient-os/desktop-install.json"
DESKTOP_MARK = "/var/lib/quotient-os/desktop-installed"
DESKTOP_SESSION = "/usr/lib/quotient-os/desktop-session"
MARK_PNG = "/usr/share/quotient-os/quotient-mark-56.png"  # made from the SVG at build time
ALLOWED_HOSTS = {"localhost", "127.0.0.1", "::1"}

